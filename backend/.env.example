# ============================================================
# Testra — Environment Configuration
# Copy this to .env and fill in your free API keys
# ============================================================

# --- Google Gemini (Primary — best for large repos, 1M context) ---
# Free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY_1=your_gemini_key_here
GEMINI_API_KEY_2=optional_second_gemini_key

# --- Groq (Secondary — ultra-fast LLaMA 3.1 70B) ---
# Free at: https://console.groq.com
GROQ_API_KEY_1=your_groq_key_here
GROQ_API_KEY_2=optional_second_groq_key

# --- Anthropic Claude Haiku (Tertiary fallback) ---
# Free tier at: https://console.anthropic.com
ANTHROPIC_API_KEY_1=your_anthropic_key_here

# --- GitHub OAuth ("Login with GitHub" → push repos on the user's behalf) ---
# 1. Create an OAuth App: https://github.com/settings/developers → "New OAuth App"
# 2. Homepage URL:            http://localhost:5173   (your frontend)
# 3. Authorization callback:  http://localhost:8000/api/auth/github/callback
# 4. Paste the Client ID + generated Client Secret below.
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Where users are sent back after login, and this backend's public URL:
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Encrypts the linked GitHub token at rest. Set a long random value in production
# (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`).
# If empty, tokens are stored unencrypted (acceptable for local dev only).
SESSION_SECRET=

# --- Email (signup verification, password reset, login OTP) ---
# Any SMTP relay works. Leave SMTP_HOST empty in development and the emails are
# printed to the server log instead of sent — the full signup → verify → OTP
# flow still runs, with no mail account needed. In production an empty relay is
# refused rather than skipped, so these checks can't silently turn themselves off.
#
# Gmail: enable 2FA, then create an App Password (NOT your account password):
#   https://myaccount.google.com/apppasswords
# Mailtrap (safe inbox for testing) or SendGrid work the same way.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM=you@gmail.com
SMTP_FROM_NAME=Testra
# STARTTLS on 587 (default). For implicit TLS on port 465 set SMTP_SSL=true.
SMTP_STARTTLS=true
SMTP_SSL=false

# Turn either check off if you need to (both need a working relay in production).
REQUIRE_EMAIL_VERIFICATION=true
LOGIN_OTP_ENABLED=true

# --- Admin console ---
# Comma-separated emails that get /admin: user management, plan & quota
# overrides, provider health, and platform analytics.
#
# This list IS the grant — there is no role column and no "promote user" button,
# so an admin cannot be created by writing to the database or by calling an API.
# Making someone an admin is an edit here plus a restart, on purpose: this is the
# one privilege that can read every account on the instance.
#
# The address must belong to an account whose email is verified, so adding an
# address nobody has signed up with (or has confirmed) grants nothing. Leave
# empty to disable the console entirely.
ADMIN_EMAILS=

# --- Billing (Stripe) ---
# Leave these empty and the app stays free for everyone: the upgrade modal shows
# a "contact us" path instead of a dead button, and no plan can be granted.
#
# To turn paid plans on:
#   1. Create a Stripe Payment Link per plan (Product → recurring price → monthly
#      and yearly), and paste the two links below.
#   2. Add a webhook endpoint at https://<your-backend>/api/billing/webhook and
#      subscribe it to exactly two events:
#        checkout.session.completed  — the first payment
#        invoice.paid                — every renewal after it
#      Paste its signing secret (whsec_...) into BILLING_WEBHOOK_SECRET.
#
# The webhook is the ONLY thing that can upgrade an account — it's the only path
# that can prove money moved. Without the signing secret every incoming webhook
# is rejected, so an unconfigured server can't be talked into granting Pro.
BILLING_CHECKOUT_URL_MONTHLY=
BILLING_CHECKOUT_URL_YEARLY=
BILLING_WEBHOOK_SECRET=
# Shown to users when billing is off, or when a payment needs a human.
BILLING_CONTACT_EMAIL=

# Prices are display-only — Stripe charges whatever the Payment Link says. Keep
# them in step with the links above or the pricing page will lie.
PRO_PRICE_MONTHLY_USD=20
PRO_PRICE_YEARLY_USD=100
FREE_GENERATIONS_PER_MONTH=5

# --- App settings ---
APP_ENV=development
LOG_LEVEL=INFO
MAX_REPO_SIZE_MB=50
MAX_FILES_PER_REPO=500
