SMTP_PORT=587
SMTP_USER=blacktheta20@gmail.com
SMTP_PASSWORD=vxzxyvbwiqazqyrm
SMTP_FROM=blacktheta20@gmail.com
SMTP_FROM_NAME=Testra
SMTP_STARTTLS=true
SMTP_SSL=false

# --- App settings ---
APP_ENV=development
LOG_LEVEL=INFO
MAX_REPO_SIZE_MB=50
MAX_FILES_PER_REPO=500

# --- Admin console ---
# The emails that get /admin. This list IS the grant — there is no role column
# and no "promote user" button, so an admin can only be created by editing this
# line and restarting. The address must belong to a verified account.
ADMIN_EMAILS=blacktheta20@gmail.com

# --- Active vulnerability scanning (OWASP ZAP) ---
# Start the daemon with:  ~/zap/start-zap.sh   (takes ~1 min to answer)
# The key here MUST match the one the daemon is started with.
ZAP_ADDRESS=http://127.0.0.1:8090
ZAP_API_KEY=testkey123
ZAP_ALLOW_ACTIVE=true
