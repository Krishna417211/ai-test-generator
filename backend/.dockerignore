# Docker does NOT read .gitignore. Without this file, `COPY . .` in the
# Dockerfile bakes real secrets and real user data into an image that gets
# pushed to a registry — where deleting the tag does not delete the layer.
#
# Everything here is either a secret, someone's data, or dead weight.

# Secrets. The image gets its config from the environment at run time, never
# from a file baked in at build time.
.env
.env.*
!.env.example

# The live SQLite database — every user, session, and plan grant on the box.
# In production this lives on a mounted volume (TESTGEN_DB), not in the image.
*.db
*.sqlite
*.sqlite3

# A 122MB virtualenv built for whoever ran `python -m venv` locally. The image
# installs its own dependencies from requirements.txt.
venv/
.venv/

# Build and tooling artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Not needed at runtime
tests/
*.md
