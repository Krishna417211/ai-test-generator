# Caddy serves the built SPA and proxies the API to the backend container, so
# the browser only ever talks to one origin. That is the whole reason CORS and
# cookie/SameSite questions don't arise in this deployment.
#
# SITE_ADDRESS decides whether this is HTTP or HTTPS, and nothing else changes:
#   :80                  → plain HTTP (staging on a bare IP)
#   testra.example.com   → Caddy gets a Let's Encrypt cert automatically
#
# Let's Encrypt will not issue for an *.amazonaws.com hostname, so the EC2
# public DNS name cannot get a cert. HTTPS needs a domain you control.
{$SITE_ADDRESS::80} {
	encode gzip

	# Security headers on every response. Testra's own /scan flags a site that
	# omits these (and graded this very deployment a C for it), so the product
	# must not fail its own audit. HSTS is ignored by browsers over plain HTTP,
	# so it is harmless on the :80 staging variant and active once a domain +
	# HTTPS are in play.
	#
	# The CSP allow-list is scoped to what this app actually loads:
	#   • Google Fonts stylesheet + font files (fonts.googleapis/gstatic).
	#   • lh3.googleusercontent.com / avatars.githubusercontent.com — profile
	#     pictures for users who signed in with Google or GitHub. Without these
	#     two hosts the browser blocks the image, and since the URL is still
	#     present the UI rendered a blank square. (An uploaded picture is a
	#     data: URI and needs none of this.)
	#   • cdn.jsdelivr.net — @monaco-editor/react (the CodeViewer) fetches the
	#     editor + its web-workers from jsdelivr on demand; worker-src blob: is
	#     for the workers it spins up. FOLLOW-UP: self-host Monaco (vite bundle)
	#     to drop jsdelivr from script-src and tighten this further.
	# Everything else stays same-origin, matching the single-origin architecture.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: https://lh3.googleusercontent.com https://avatars.githubusercontent.com; connect-src 'self' https://cdn.jsdelivr.net; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		# Don't advertise the server software.
		-Server
	}

	# Generation streams tokens over SSE. Caddy disables buffering for
	# text/event-stream on its own, but this route is the product's whole
	# selling point, so it says so explicitly rather than relying on sniffing.
	handle /api/stream/* {
		reverse_proxy backend:8000 {
			flush_interval -1
		}
	}

	# flush_interval -1 disables response buffering for the whole API, not just
	# the SSE route above. /api/scan, /api/generate and /api/publish stream NDJSON
	# progress, and Caddy only auto-disables buffering for text/event-stream — so
	# application/x-ndjson was being buffered and the client saw nothing until the
	# response completed. Invisible on a passive scan that finishes in seconds;
	# fatal on an ACTIVE (ZAP) scan, which runs for minutes and would look hung
	# and risk hitting a timeout with no bytes on the wire.
	#
	# Immediate flushing costs nothing meaningful for ordinary JSON replies, and
	# scoping it to /api/* keeps the static file server buffered as normal.
	handle /api/* {
		reverse_proxy backend:8000 {
			flush_interval -1
		}
	}

	# Health check and the interactive API docs live on the backend too.
	handle /health {
		reverse_proxy backend:8000
	}

	handle /docs* {
		reverse_proxy backend:8000
	}

	handle /openapi.json {
		reverse_proxy backend:8000
	}

	# Everything else is the SPA. try_files sends unknown paths to index.html so
	# a hard refresh on a client-side route (/dashboard, /admin) doesn't 404.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
